################################################################################
## Minimal QNX IFS -- TEMPLATE.
##
## This file is not handed to mkifs directly. qnx-ifs.bbclass expands the two
## @...@ markers below from the recipes listed in QNX_IFS_INSTALL and writes the
## real .build file into ${B} (and into the deploy dir next to the .ifs, so you
## can always read exactly what was built).
##
## The point: adding an application means adding its name to QNX_IFS_INSTALL in
## the image recipe. This file is only touched when the *image* changes -- a
## different console, a different boot address, a new driver.
##
## What stays here is genuinely image-specific: the boot line, the console, and
## the shape of the startup script. Modelled on
## qnx_guests/images/guest-2/qnx800-guest-2.build from the QNX hypervisor
## project, stripped to the bone: no m4 includes, no networking, no ssh/qconn,
## no block or watchdog drivers.
##
## Unqualified names (startup-armv8_fm, procnto-smp-instr, ksh, devc-virtio)
## are resolved by mkifs out of $QNX_TARGET. Names contributed by recipes
## resolve the same way out of the stage tree passed as `mkifs -r`, which is why
## that tree mirrors $QNX_TARGET's layout (aarch64le/bin/...).
##
## Resolving a name is all mkifs does: it never adds a file that is not listed,
## so libc.so and the rest of the runtime are not implied by the binaries that
## need them. qnx-ifs.bbclass works that closure out from DT_NEEDED and appends
## it (QNX_IFS_AUTO_DEPS). A command merely *named* in the startup script is not
## covered -- see the base system section at the bottom.
################################################################################

[-optional]
[+keeplinked]
[image=@QNX_IMAGE_ADDR@]

[virtual=@QNX_IMAGE_VIRTUAL@] boot = {
    @QNX_STARTUP@ @QNX_STARTUP_ARGS@
    PATH=@QNX_IFS_PATH@ LD_LIBRARY_PATH=@QNX_IFS_LD_LIBRARY_PATH@ @QNX_KERNEL@ @QNX_KERNEL_ARGS@
}

[+script] startup-script = {
    SYSNAME=nto
    TERM=qansi

    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    # Needed for ksh to run anything below
    pipe
    slogger2

    # virtio-console. Must match the guest's qvmconf:
    #   vdev virtio-console / intr gic:42
    devc-virtio 0x20000000,42
    waitfor /dev/vcon1 4
    reopen /dev/vcon1

    display_msg " "
    display_msg "Starting applications ..."

    ############################################################################
    ## Contributed by QNX_IFS_STARTUP_CMD of each installed recipe.
    ############################################################################
@QNX_IFS_STARTUP@

    display_msg "Starting shell ..."
    [+session] ksh &
}

[uid=0 gid=0]

# /bin/sh, /tmp and the base utilities are not here: they come from the
# qnx-base-runtime recipe, which this image installs. The console link stays,
# because which device is the console is a property of the image and of nothing
# else -- this one is a guest, so it is the virtio console.
[type=link] /dev/console=/dev/vcon1

################################################################################
## Applications -- generated from QNX_IFS_INSTALL. Do not add entries by hand;
## add the recipe to QNX_IFS_INSTALL in the image recipe instead.
################################################################################
@QNX_IFS_FILES@

################################################################################
## Base system: the console driver, and nothing else.
##
## The shell, the loader, pipe and slogger2 and the rest of what the startup
## script above calls all come from the qnx-base-runtime recipe -- this image
## installs it by name, so there is nothing to list and nothing to keep in step.
## Listing them here as well is not additive: mkifs fails with
## "Entry 'bin/sh' redefined".
##
## Their shared libraries are appended by qnx-ifs.bbclass, which reads DT_NEEDED
## from every binary in the generated file. ls, cat, uname and friends are not
## here either: QNX 8 has no standalone versions, they come from toybox, which
## qnx-ifs.bbclass adds along with a link per command.
################################################################################
/sbin/devc-virtio=devc-virtio
